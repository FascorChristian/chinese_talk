# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="tu_clave_de_gemini_aqui"

# GEMINI_MODEL: Model code for Google GenAI API (Gemini 3.1 Flash Lite: 15 RPM / 500 RPD)
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_MAX_RPM="15"

# GOOGLE_SCRIPT_WEBHOOK_URL: Web App URL from Google Apps Script for Google Sheets & Drive sync
GOOGLE_SCRIPT_WEBHOOK_URL=""
# GOOGLE_SCRIPT_API_TOKEN: Secret token for authorized Google Apps Script access
GOOGLE_SCRIPT_API_TOKEN="tu_token_secreto_aqui"

PORT=3000
NODE_ENV=development
